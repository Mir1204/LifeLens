# Do not commit .env or .env.local. Generate JWT_SECRET_KEY with a CSPRNG.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Optional rotation: retain prior key IDs only until their tokens expire.
# JWT_SECRET_KEYS={"2026-09":"old-secret","2026-10":"new-secret"}
# JWT_ACTIVE_KEY_ID=2026-10
GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
ALLOWED_ORIGINS=https://your-production-web-origin.example
BURNOUT_MODEL_PATH=app/ml/artifacts/burnout_model.joblib
OVERSPEND_MODEL_PATH=app/ml/artifacts/overspend_model.joblib
STATIC_STRESS_MODEL_PATH=app/ml/artifacts/static_stress_model.joblib
