# Do not commit .env or .env.local. Generate JWT_SECRET_KEY with a CSPRNG.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://your-production-web-origin.example
BURNOUT_MODEL_PATH=app/ml/artifacts/burnout_model.joblib
OVERSPEND_MODEL_PATH=app/ml/artifacts/overspend_model.joblib
STATIC_STRESS_MODEL_PATH=app/ml/artifacts/static_stress_model.joblib
